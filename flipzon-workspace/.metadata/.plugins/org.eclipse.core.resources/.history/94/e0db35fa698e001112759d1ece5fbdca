package com.coforge.training.flipzon.cartservice.serviceimpl;

import java.util.List;

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;

import java.util.ArrayList;

import org.springframework.beans.BeanUtils;

import com.coforge.training.flipzon.cartservice.entity.Cart;

import com.coforge.training.flipzon.cartservice.dto.CartRequest;
import com.coforge.training.flipzon.cartservice.dto.CartResponse;
import com.coforge.training.flipzon.cartservice.feign.ProductFeignClient;
import com.coforge.training.flipzon.cartservice.feign.UserFeignClient;
import com.coforge.training.flipzon.cartservice.repository.CartRepository;
import com.coforge.training.flipzon.cartservice.service.CartService;

@Service
public class CartServiceImpl implements CartService {

    @Autowired
    private CartRepository cartRepository;

    @Autowired
    private UserFeignClient userFeignClient;

    @Autowired
    private ProductFeignClient productFeignClient;

    @Override
    public CartResponse addToCart(CartRequest request) {

        // Verify user exists
        userFeignClient.getUserById(request.getUserId());

        // Verify product exists
        productFeignClient.getProductById(request.getProductId());

        Cart existingCart = cartRepository.findByUserIdAndProductId(
                request.getUserId(),
                request.getProductId());

        if (existingCart != null) {

            existingCart.setQuantity(
                    existingCart.getQuantity() + request.getQuantity());

            Cart updatedCart = cartRepository.save(existingCart);

            CartResponse response = new CartResponse();
            BeanUtils.copyProperties(updatedCart, response);

            return response;
        }

        Cart cart = new Cart();

        BeanUtils.copyProperties(request, cart);

        Cart savedCart = cartRepository.save(cart);

        CartResponse response = new CartResponse();

        BeanUtils.copyProperties(savedCart, response);

        return response;
    }

